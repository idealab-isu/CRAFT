# Intermediate pipeline artifacts (Flask demo runtime outputs)
pipeline/plans/
pipeline/scad_scripts/
pipeline/tmp_views/
pipeline/quick_test_results/
pipeline/static/images/
pipeline/static/stl/

# Large data (regenerate via pipeline/scripts/build_knowledge_base.py)
pipeline/kb_data/
ground_truth/nopscadlib/nopscadlib_component_catalog.json

# Ground-truth STLs (large, regenerate with experiments/01_ground_truth/render_nopscadlib.py)
ground_truth/nopscadlib/stl/

# FID Inception feature caches (regenerable)
metrics/**/_cache/

# ---------------------------------------------------------------------------
# Light-repo policy: regenerable bulk artifacts are NOT committed.
# The repository ships generated OpenSCAD programs (.scad) and results.json;
# rendered views (.png) and exported meshes (.stl) are reproduced by the
# pipeline (experiments/01_ground_truth/ and experiments/02_benchmark/).
# ---------------------------------------------------------------------------
results/**/png/
results/**/stl/
results/**/temp/
additional_study/**/png/
additional_study/**/stl/

# Archive — superseded code kept for provenance; heavy media excluded
additional_study/_archive/pipeline_static_images/
additional_study/_archive/pipeline_static_stl/

# Archive media (provenance code only — meshes/renders excluded)
additional_study/_archive/**/*.stl
additional_study/_archive/**/*.png
additional_study/_archive/**/_renders/
